{
  "openapi": "3.1.0",
  "info": {
    "title": "Petstore API (Spring Boot legacy)",
    "description": "Petstore spec generated by Spring Boot codegen — integer fields carry string examples, which is the pattern exercised by this fixture.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local development"
    }
  ],
  "paths": {
    "/api/v1/pets": {
      "post": {
        "summary": "Register a pet (v1)",
        "description": "Creates a pet record. Spring Boot codegen emits string literals as examples for integer fields.",
        "operationId": "registerPetV1",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewPetRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pet registered successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PetResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Owner not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/pets": {
      "post": {
        "summary": "Register a pet (v2)",
        "description": "Extended pet registration with alphanumeric breed and category codes.",
        "operationId": "registerPetV2",
        "parameters": [
          {
            "name": "Authorization",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NewPetRequestV2"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Pet registered successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PetResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameters.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Owner not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "NewPetRequest": {
        "type": "object",
        "description": "v1 request — ownerId and categoryId are integers whose examples were emitted as strings by Spring Boot codegen.",
        "required": ["name", "ownerId", "categoryId"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Pet name.",
            "example": "Rex"
          },
          "tag": {
            "type": "string",
            "description": "Optional tag.",
            "example": "labrador"
          },
          "ownerId": {
            "type": "number",
            "description": "Numeric owner identifier.",
            "example": 100200300,
            "minimum": 0
          },
          "categoryId": {
            "type": "integer",
            "format": "int32",
            "description": "Category code. Spring Boot codegen emits this as a string example.",
            "example": "0001",
            "minimum": 0
          },
          "age": {
            "type": "integer",
            "format": "int32",
            "description": "Age in months. Spring Boot codegen emits this as a string example.",
            "example": "06",
            "minimum": 0
          }
        }
      },
      "NewPetRequestV2": {
        "type": "object",
        "description": "v2 request — uses alphanumeric codes instead of plain integers.",
        "required": ["name", "breedCode", "categoryCode", "age"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Pet name.",
            "example": "Buddy"
          },
          "breedCode": {
            "type": "string",
            "description": "Alphanumeric breed code.",
            "example": "LAB01",
            "maxLength": 6,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9]*$"
          },
          "categoryCode": {
            "type": "string",
            "description": "Alphanumeric category code.",
            "example": "DOG",
            "maxLength": 5,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9]*$"
          },
          "age": {
            "type": "integer",
            "format": "int32",
            "description": "Age in months.",
            "example": 12,
            "maximum": 360,
            "minimum": 0
          }
        }
      },
      "PetResponse": {
        "type": "object",
        "properties": {
          "petId": {
            "type": "string",
            "description": "Generated pet identifier."
          },
          "name": {
            "type": "string",
            "description": "Pet name."
          },
          "status": {
            "type": "string",
            "description": "Registration status.",
            "enum": ["available", "pending", "sold"]
          },
          "vaccinations": {
            "type": "integer",
            "format": "int32",
            "description": "Number of vaccinations on record."
          },
          "tags": {
            "type": "array",
            "description": "List of tags associated with the pet.",
            "items": {
              "$ref": "#/components/schemas/Tag"
            }
          },
          "returnCode": {
            "type": "string",
            "description": "Processing return code."
          },
          "returnMessage": {
            "type": "string",
            "description": "Human-readable return message."
          }
        }
      },
      "Tag": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "Tag identifier."
          },
          "name": {
            "type": "string",
            "description": "Tag label."
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "string",
            "description": "Error code."
          },
          "message": {
            "type": "string",
            "description": "Error description."
          }
        }
      }
    }
  }
}
